# Public site URL — used by sitemap.xml, robots.txt, and absolute Open Graph URLs.
# Override only if you deploy to a different domain.
NEXT_PUBLIC_SITE_URL=https://chinaheritageguide.com

# Google AdSense publisher ID. Format: ca-pub-XXXXXXXXXXXXXXXX
# Leave unset locally; production deploy injects the real value once AdSense
# approves the site. While unset, no AdSense script is loaded.
# NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-1234567890123456

# Google Analytics 4 measurement ID. Format: G-XXXXXXXXXX
# Leave unset until you create a GA4 property.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
